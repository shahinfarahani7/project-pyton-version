EDGEMINT_ENVIRONMENT=development
EDGEMINT_DATABASE_URL=postgresql+psycopg://edgemint:change-me@localhost:5432/edgemint
POSTGRES_DB=edgemint
POSTGRES_USER=edgemint
POSTGRES_PASSWORD=change-me
POSTGRES_DEV_IMAGE=postgres:18.4@sha256:REPLACE_WITH_APPROVED_DIGEST
POSTGRES_TOOLS_IMAGE=postgres:18.4@sha256:REPLACE_WITH_APPROVED_DIGEST
PYTHON_RUNTIME_IMAGE=python:3.13.14-slim@sha256:REPLACE_WITH_APPROVED_DIGEST
NODE_RUNTIME_IMAGE=node:24-bookworm-slim@sha256:REPLACE_WITH_APPROVED_DIGEST
NGINX_RUNTIME_IMAGE=nginx:1.27-alpine@sha256:REPLACE_WITH_APPROVED_DIGEST
MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z@sha256:REPLACE_WITH_APPROVED_DIGEST
MAILPIT_IMAGE=axllent/mailpit:v1.27.8@sha256:REPLACE_WITH_APPROVED_DIGEST
MINIO_ROOT_PASSWORD=change-me
EDGEMINT_ALLOW_INSECURE_DEVELOPMENT_TOKENS=false

# Local Docker stack: copy .env.docker.example to .env.docker and run:
#   pwsh tools/docker_up.ps1
#   bash tools/docker_up.sh
# Production image pins must use digest values from production/RELEASE-INPUTS.yaml.
