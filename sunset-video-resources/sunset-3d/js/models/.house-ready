buildHouse({ env, detail:'high'|'mid', panels:true, glow:0, seed:1, apron:true }) -> { group, panels[] (12 = 2x6 Groups, userData.home={position,quaternion}, userData.index=[row,col]), rails, setGlow(v 0..1.5), setRim(k=1, pow=3) (warm backlit rim from the key light, 0 = off), anchors:{ roof, battery, meter (now on the front wall of the end bay) }, bounds, sunCatchers[], materials, meshes, dims }; also exports HOUSE, box, place, paint, metreUV, tune, Bucket, stoneMaterial, translucencyGLSL, rimGLSL, RIM_OFF, setRim(obj,k,p), bledTexture(img|canvas,{despill}), noise3, flatStone(seed,r,h,stretch)
