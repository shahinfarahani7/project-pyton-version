{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.edgemint.io/evidence-attestation-v1.0.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "releaseId",
    "commitSha",
    "subject",
    "status",
    "verified",
    "generatedAt",
    "producer"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^EM-[0-9]{8}-[A-Z0-9]{6,20}$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "passed",
        "verified",
        "approved"
      ]
    },
    "verified": {
      "const": true
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 3
    }
  }
}
