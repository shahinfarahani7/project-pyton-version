{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.edgemint.io/trusted-roots-v1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "commitSha",
    "subject",
    "status",
    "cosignPublicKeySha256",
    "cosignKmsKeyArn",
    "verifiedAt",
    "verified",
    "generatedAt",
    "producer"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^EM-[0-9]{8}-[A-Z0-9]{6,20}$"
    },
    "commitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "subject": {
      "const": "trusted-roots"
    },
    "status": {
      "const": "verified"
    },
    "cosignPublicKeySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cosignKmsKeyArn": {
      "type": "string",
      "pattern": "^arn:aws:kms:[a-z0-9-]+:[0-9]{12}:key/[A-Za-z0-9-]+$"
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verified": {
      "const": true
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 3
    }
  }
}
