# Local Docker stack — copy to .env and adjust secrets.
# Production releases must use digest-pinned images from production/RELEASE-INPUTS.yaml.

EDGEMINT_ENVIRONMENT=development
EDGEMINT_DATABASE_URL=postgresql+psycopg://edgemint:local-docker-secret@postgresql:5432/edgemint
EDGEMINT_ALLOW_INSECURE_DEVELOPMENT_TOKENS=true
EDGEMINT_JWT_SIGNING_SECRET=local-docker-jwt-secret-change-me
EDGEMINT_JWT_ISSUER=edgemint-local
# URL-safe base64 encoding of exactly 32 random bytes. Required outside development/test.
EDGEMINT_LEASE_CREDENTIAL_ENCRYPTION_KEY=
EDGEMINT_WORKER_API_PUBLIC_BASE_URL=http://172.20.34.71:8081
# Host LAN IP for remote Android workers (physical device or Studio on another machine).
EDGEMINT_DEV_API_PUBLIC_URL=http://172.20.34.71:8080
EDGEMINT_WORKER_PUBLIC_URL=http://172.20.34.71:8081

POSTGRES_DB=edgemint
POSTGRES_USER=edgemint
POSTGRES_PASSWORD=local-docker-secret

# Local tags (development only). Pin by digest for CI/production.
POSTGRES_DEV_IMAGE=postgres:18-bookworm
POSTGRES_TOOLS_IMAGE=postgres:18-bookworm
PYTHON_RUNTIME_IMAGE=python:3.13.14-slim-bookworm
NODE_RUNTIME_IMAGE=node:24-bookworm-slim
NGINX_RUNTIME_IMAGE=nginx:1.27-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z
MAILPIT_IMAGE=axllent/mailpit:v1.27.8
MINIO_ROOT_PASSWORD=local-minio-secret

# Portal build-time API URL (browser on host reaches api-gateway publish port)
VITE_CUSTOMER_API_BASE_URL=http://localhost:8080
VITE_OPERATIONS_API_BASE_URL=http://localhost:8083

# Hugging Face Read token for server-side Gemma model proxy (mobile workers never see this).
HUGGINGFACE_TOKEN=
