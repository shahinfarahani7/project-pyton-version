{
  "$id": "https://schemas.edgemint.example/v1/servicedefinition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "ServiceDefinition"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "asynchronousEventsProduced": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dataOwnership": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deploymentClass": {
          "type": "string"
        },
        "ownerTeam": {
          "type": "string"
        },
        "piiAccess": {
          "type": "string"
        },
        "service": {
          "type": "string"
        },
        "sloRef": {
          "type": "string"
        },
        "synchronousDependencies": {
          "items": {},
          "type": "array"
        }
      },
      "required": [
        "asynchronousEventsProduced",
        "dataOwnership",
        "deploymentClass",
        "ownerTeam",
        "piiAccess",
        "service",
        "sloRef",
        "synchronousDependencies"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint ServiceDefinition",
  "type": "object"
}
