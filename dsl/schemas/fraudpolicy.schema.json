{
  "$id": "https://schemas.edgemint.example/v1/fraudpolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "edgemint.io/v1"},
    "kind": {"const": "FraudPolicy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "status", "owners"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "status": {"type": "string", "enum": ["draft", "evaluation", "active", "deprecated", "retired", "blocked"]},
        "owners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "description": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoreScaleBps", "signals", "actionBands", "evidenceRetentionDays", "appealAllowed"],
      "properties": {
        "scoreScaleBps": {"type": "integer", "const": 10000},
        "signals": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["weightBps"],
            "properties": {"weightBps": {"type": "integer", "minimum": 0, "maximum": 10000}}
          }
        },
        "actionBands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimumScoreBps", "actions", "rewardHold"],
            "properties": {
              "minimumScoreBps": {"type": "integer", "minimum": 0, "maximum": 10000},
              "actions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "rewardHold": {"type": "boolean"}
            }
          }
        },
        "evidenceRetentionDays": {"type": "integer", "minimum": 1},
        "appealAllowed": {"type": "boolean"}
      }
    }
  }
}
