{
  "$id": "https://schemas.edgemint.example/v1/disputepolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "DisputePolicy"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "allowedReasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "financialHold": {
          "additionalProperties": false,
          "properties": {
            "scope": {
              "type": "string"
            },
            "workerRewardHoldWhenEvidenceRelevant": {
              "type": "boolean"
            }
          },
          "required": [
            "scope",
            "workerRewardHoldWhenEvidenceRelevant"
          ],
          "type": "object"
        },
        "manualEvidenceRequired": {
          "type": "boolean"
        },
        "resolutionActions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "states": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "submissionWindowDays": {
          "type": "integer"
        }
      },
      "required": [
        "allowedReasons",
        "financialHold",
        "manualEvidenceRequired",
        "resolutionActions",
        "states",
        "submissionWindowDays"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint DisputePolicy",
  "type": "object"
}
