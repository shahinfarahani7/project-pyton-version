{
  "$id": "https://schemas.edgemint.example/v1/checkpointpolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "CheckpointPolicy"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "allowedTaskTypes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "encryptionRequired": {
          "type": "boolean"
        },
        "invalidCheckpointAction": {
          "type": "string"
        },
        "maximumIntervalSeconds": {
          "type": "integer"
        },
        "minimumProgressDeltaMilli": {
          "type": "integer"
        },
        "requiredFields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resumeRequires": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "retentionMinutes": {
          "type": "integer"
        }
      },
      "required": [
        "allowedTaskTypes",
        "encryptionRequired",
        "invalidCheckpointAction",
        "maximumIntervalSeconds",
        "minimumProgressDeltaMilli",
        "requiredFields",
        "resumeRequires",
        "retentionMinutes"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint CheckpointPolicy",
  "type": "object"
}
