{
  "$id": "https://schemas.edgemint.example/v1/costmodel.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "CostModel"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "cloudFallbackProbabilityBps": {
          "type": "integer"
        },
        "currency": {
          "type": "string"
        },
        "reviewFrequency": {
          "type": "string"
        },
        "rules": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cloudFallbackExpectedMicros": {
                "type": "integer"
              },
              "fraudReserveMicros": {
                "type": "integer"
              },
              "paymentSupportMicros": {
                "type": "integer"
              },
              "storageEgressMicros": {
                "type": "integer"
              },
              "taskType": {
                "type": "string"
              },
              "verifierCostMicros": {
                "type": "integer"
              },
              "workerRewardMicros": {
                "type": "integer"
              }
            },
            "required": [
              "cloudFallbackExpectedMicros",
              "fraudReserveMicros",
              "paymentSupportMicros",
              "storageEgressMicros",
              "taskType",
              "verifierCostMicros",
              "workerRewardMicros"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "supportAllocationMethod": {
          "type": "string"
        }
      },
      "required": [
        "cloudFallbackProbabilityBps",
        "currency",
        "reviewFrequency",
        "rules",
        "supportAllocationMethod"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint CostModel",
  "type": "object"
}
