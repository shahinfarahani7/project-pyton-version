{
  "$id": "https://schemas.edgemint.example/v1/checkpointpolicymatrix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "CheckpointPolicyMatrix"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "defaultMaximumIntervalSeconds": {
          "minimum": 1,
          "type": "integer"
        },
        "entries": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "checkpointEnabled": {
                "type": "boolean"
              },
              "checkpointStrategy": {
                "enum": [
                  "none",
                  "stage",
                  "chunk"
                ],
                "type": "string"
              },
              "maximumIntervalSeconds": {
                "minimum": 1,
                "type": "integer"
              },
              "taskType": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "taskType",
              "checkpointEnabled",
              "checkpointStrategy"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "mobileCheckpointPolicyRef": {
          "type": "string"
        }
      },
      "required": [
        "defaultMaximumIntervalSeconds",
        "entries",
        "mobileCheckpointPolicyRef"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint CheckpointPolicyMatrix",
  "type": "object"
}
