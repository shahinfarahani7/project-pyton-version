{
  "$id": "https://schemas.edgemint.example/v1/entitlementpolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "EntitlementPolicy"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "features": {
          "additionalProperties": false,
          "properties": {
            "customKeys": {
              "type": "boolean"
            },
            "dedicatedPool": {
              "type": "boolean"
            },
            "humanReview": {
              "type": "boolean"
            },
            "rbac": {
              "type": "boolean"
            },
            "sso": {
              "type": "boolean"
            }
          },
          "required": [
            "customKeys",
            "dedicatedPool",
            "humanReview",
            "rbac",
            "sso"
          ],
          "type": "object"
        },
        "hardLimitBehavior": {
          "type": "string"
        },
        "limits": {
          "additionalProperties": false,
          "properties": {
            "apiRequestsPerMinute": {
              "type": "integer"
            },
            "concurrentLeases": {
              "type": "integer"
            },
            "logRetentionDays": {
              "type": "integer"
            },
            "monthlyIncludedCreditMicros": {
              "type": "integer"
            }
          },
          "required": [
            "apiRequestsPerMinute",
            "concurrentLeases",
            "logRetentionDays",
            "monthlyIncludedCreditMicros"
          ],
          "type": "object"
        },
        "plan": {
          "type": "string"
        },
        "priceMultiplierBps": {
          "type": "integer"
        }
      },
      "required": [
        "features",
        "hardLimitBehavior",
        "limits",
        "plan",
        "priceMultiplierBps"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint EntitlementPolicy",
  "type": "object"
}
