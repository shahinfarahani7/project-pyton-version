{
  "$id": "https://schemas.edgemint.example/v1/scenario.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "Scenario"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "expectedErrorCode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "expectedEvents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fixtures": {
          "additionalProperties": false,
          "properties": {
            "actor": {
              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "operationIds": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "requirements": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [],
          "type": "object"
        },
        "given": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "stateMachineRef": {
          "type": "string"
        },
        "then": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "useCaseRef": {
          "type": "string"
        },
        "when": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "expectedErrorCode",
        "expectedEvents",
        "fixtures",
        "given",
        "id",
        "mode",
        "then",
        "when"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint Scenario",
  "type": "object"
}
