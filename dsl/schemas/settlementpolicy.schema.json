{
  "$id": "https://schemas.edgemint.example/v1/settlementpolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "SettlementPolicy"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "claimPolicyRef": {
          "type": "string"
        },
        "claimWindows": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "schedule": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "schedule"
          ],
          "type": "object"
        },
        "conversion": {
          "additionalProperties": false,
          "properties": {
            "dustAction": {
              "type": "string"
            },
            "integerAtomicUnits": {
              "type": "boolean"
            },
            "mode": {
              "type": "string"
            },
            "rateLockSeconds": {
              "type": "integer"
            }
          },
          "required": [
            "dustAction",
            "integerAtomicUnits",
            "mode",
            "rateLockSeconds"
          ],
          "type": "object"
        },
        "failureStates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reconciliation": {
          "additionalProperties": false,
          "properties": {
            "batchToProviderOrChain": {
              "type": "boolean"
            },
            "offchainToBatch": {
              "type": "boolean"
            },
            "requiredBeforeClose": {
              "type": "boolean"
            }
          },
          "required": [
            "batchToProviderOrChain",
            "offchainToBatch",
            "requiredBeforeClose"
          ],
          "type": "object"
        },
        "unitOfAccount": {
          "type": "string"
        }
      },
      "required": [
        "claimPolicyRef",
        "claimWindows",
        "conversion",
        "failureStates",
        "reconciliation",
        "unitOfAccount"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint SettlementPolicy",
  "type": "object"
}
