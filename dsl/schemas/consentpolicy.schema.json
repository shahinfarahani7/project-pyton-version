{
  "$id": "https://schemas.edgemint.example/v1/consentpolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "ConsentPolicy"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "activeLeaseBehavior": {
          "type": "string"
        },
        "evidenceRetentionDays": {
          "type": "integer"
        },
        "renewOnMajorVersion": {
          "type": "boolean"
        },
        "requiredConsents": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resourceControls": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "withdrawalStopsNewAssignmentsImmediately": {
          "type": "boolean"
        },
        "perTaskConfirmationAllowed": {
          "type": "boolean"
        }
      },
      "required": [
        "activeLeaseBehavior",
        "evidenceRetentionDays",
        "renewOnMajorVersion",
        "requiredConsents",
        "resourceControls",
        "withdrawalStopsNewAssignmentsImmediately",
        "perTaskConfirmationAllowed"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint ConsentPolicy",
  "type": "object"
}
