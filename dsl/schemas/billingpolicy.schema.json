{
  "$id": "https://schemas.edgemint.example/v1/billingpolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "BillingPolicy"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string"
        },
        "failureMatrixRef": {
          "type": "string"
        },
        "finalization": {
          "additionalProperties": false,
          "properties": {
            "idempotencyScope": {
              "type": "string"
            },
            "invariant": {
              "type": "string"
            },
            "trigger": {
              "type": "string"
            }
          },
          "required": [
            "idempotencyScope",
            "invariant",
            "trigger"
          ],
          "type": "object"
        },
        "invoice": {
          "additionalProperties": false,
          "properties": {
            "aggregateMicrosThenRoundToCurrencyMinor": {
              "type": "boolean"
            },
            "roundingMode": {
              "type": "string"
            }
          },
          "required": [
            "aggregateMicrosThenRoundToCurrencyMinor",
            "roundingMode"
          ],
          "type": "object"
        },
        "moneyUnit": {
          "type": "string"
        },
        "reservation": {
          "additionalProperties": false,
          "properties": {
            "expiresWithQuote": {
              "type": "boolean"
            },
            "renewalRequiresRequote": {
              "type": "boolean"
            },
            "requiredBeforeQueue": {
              "type": "boolean"
            }
          },
          "required": [
            "expiresWithQuote",
            "renewalRequiresRequote",
            "requiredBeforeQueue"
          ],
          "type": "object"
        },
        "tax": {
          "additionalProperties": false,
          "properties": {
            "adapterRequired": {
              "type": "boolean"
            },
            "unknownTaxAction": {
              "type": "string"
            }
          },
          "required": [
            "adapterRequired",
            "unknownTaxAction"
          ],
          "type": "object"
        }
      },
      "required": [
        "currency",
        "failureMatrixRef",
        "finalization",
        "invoice",
        "moneyUnit",
        "reservation",
        "tax"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint BillingPolicy",
  "type": "object"
}
