{
  "$id": "https://schemas.edgemint.example/v1/tokenpolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "TokenPolicy"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "activationGates": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "claimEnabled": {
          "type": "boolean"
        },
        "claimPolicyRef": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "prohibitions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "storePresentation": {
          "additionalProperties": false,
          "properties": {
            "describeAs": {
              "type": "string"
            },
            "forbiddenTerms": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "describeAs",
            "forbiddenTerms"
          ],
          "type": "object"
        },
        "utility": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "activationGates",
        "claimEnabled",
        "claimPolicyRef",
        "mode",
        "prohibitions",
        "storePresentation",
        "utility"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint TokenPolicy",
  "type": "object"
}
