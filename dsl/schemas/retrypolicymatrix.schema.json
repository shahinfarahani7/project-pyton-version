{
  "$id": "https://schemas.edgemint.example/v1/retrypolicymatrix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "RetryPolicyMatrix"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "defaultMaxAutomaticRetries": {
          "minimum": 0,
          "type": "integer"
        },
        "entries": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "executable": {
                "type": "boolean"
              },
              "maxAutomaticRetries": {
                "minimum": 0,
                "type": "integer"
              },
              "qualityFailureRetryClass": {
                "enum": [
                  "immediate_other_worker",
                  "stronger_worker",
                  "no_retry"
                ],
                "type": "string"
              },
              "retryClass": {
                "enum": [
                  "immediate_other_worker",
                  "stronger_worker",
                  "no_retry"
                ],
                "type": "string"
              },
              "taskType": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "taskType",
              "retryClass",
              "executable"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "defaultMaxAutomaticRetries",
        "entries"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint RetryPolicyMatrix",
  "type": "object"
}
