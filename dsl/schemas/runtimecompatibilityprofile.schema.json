{
  "$id": "https://schemas.edgemint.example/v1/runtimecompatibilityprofile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "EdgeMint RuntimeCompatibilityProfile",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "edgemint.io/v1" },
    "kind": { "const": "RuntimeCompatibilityProfile" },
    "metadata": {
      "additionalProperties": false,
      "type": "object",
      "required": ["name", "version", "status", "owners"],
      "properties": {
        "description": { "type": "string" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": {
          "type": "string",
          "enum": ["draft", "evaluation", "active", "deprecated", "retired", "blocked"]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "spec": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "recommendedRuntimeClasses",
        "runtimeClasses",
        "coRunRules",
        "taskRequirements"
      ],
      "properties": {
        "recommendedRuntimeClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "runtimeClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "id",
              "nativePluginId",
              "supportedAbis",
              "minimumAndroidApi",
              "supportedPageSizeKb",
              "maximumSessionsPerDevice"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "displayName": { "type": "string", "minLength": 1 },
              "nativePluginId": { "type": "string", "minLength": 1 },
              "supportedAbis": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "minimumAndroidApi": { "type": "integer", "minimum": 1 },
              "supportedPageSizeKb": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "integer", "enum": [4, 16] }
              },
              "maximumSessionsPerDevice": { "type": "integer", "minimum": 1 },
              "certifiedMaximumSessionsPerDevice": { "type": "integer", "minimum": 1 },
              "exclusive": { "type": "boolean" }
            }
          }
        },
        "coRunRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["runtimeA", "runtimeB", "coRunAllowed"],
            "properties": {
              "runtimeA": { "type": "string", "minLength": 1 },
              "runtimeB": { "type": "string", "minLength": 1 },
              "coRunAllowed": { "type": "boolean" },
              "exclusiveGroup": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "taskRequirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["taskRuntimeClass", "requiredWorkerRuntimeClasses"],
            "properties": {
              "taskRuntimeClass": { "type": "string", "minLength": 1 },
              "requiredWorkerRuntimeClasses": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "minimumDeviceTier": {
                "type": "string",
                "enum": ["T1", "T2", "T3", "T4"]
              }
            }
          }
        }
      }
    }
  }
}
