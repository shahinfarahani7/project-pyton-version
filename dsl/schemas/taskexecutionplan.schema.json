{
  "$id": "https://schemas.edgemint.example/v1/taskexecutionplan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "EdgeMint TaskExecutionPlan",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "edgemint.io/v1" },
    "kind": { "const": "TaskExecutionPlan" },
    "metadata": {
      "additionalProperties": false,
      "type": "object",
      "required": ["name", "version", "status", "owners"],
      "properties": {
        "description": { "type": "string" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": {
          "type": "string",
          "enum": ["draft", "evaluation", "active", "deprecated", "retired", "blocked"]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "spec": {
      "additionalProperties": false,
      "type": "object",
      "required": ["taskType", "stages"],
      "properties": {
        "taskType": { "type": "string", "minLength": 1 },
        "inputMode": {
          "type": "string",
          "enum": ["text", "image", "document", "flex"]
        },
        "planVersion": { "type": "string", "minLength": 1 },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sequence",
              "name",
              "operation",
              "runtimeClass",
              "checkpointEnabled",
              "estimatedDurationMs"
            ],
            "properties": {
              "sequence": { "type": "integer", "minimum": 1 },
              "name": { "type": "string", "minLength": 1 },
              "operation": { "type": "string", "minLength": 1 },
              "runtimeClass": { "type": "string", "minLength": 1 },
              "requiredModelIds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "checkpointEnabled": { "type": "boolean" },
              "retryPolicy": {
                "type": "string",
                "enum": ["none", "stage_once", "stage_with_backoff"]
              },
              "validationRule": { "type": "string" },
              "estimatedDurationMs": { "type": "integer", "minimum": 0 },
              "exclusiveGroup": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
