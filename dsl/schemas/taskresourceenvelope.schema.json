{
  "$id": "https://schemas.edgemint.example/v1/taskresourceenvelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "EdgeMint TaskResourceEnvelope",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "edgemint.io/v1" },
    "kind": { "const": "TaskResourceEnvelope" },
    "metadata": {
      "additionalProperties": false,
      "type": "object",
      "required": ["name", "version", "status", "owners"],
      "properties": {
        "description": { "type": "string" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": {
          "type": "string",
          "enum": ["draft", "evaluation", "active", "deprecated", "retired", "blocked"]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "spec": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "taskType",
        "runtimeClass",
        "cpuUnits",
        "memoryReservationBytes",
        "storageReservationBytes",
        "acceleratorUnits",
        "modelSessionUnits",
        "estimatedDurationMs",
        "maximumParallelPerDevice",
        "exclusiveGroup"
      ],
      "properties": {
        "taskType": { "type": "string", "minLength": 1 },
        "runtimeClass": { "type": "string", "minLength": 1 },
        "requiredModelIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "cpuUnits": { "type": "integer", "minimum": 1 },
        "memoryReservationBytes": { "type": "integer", "minimum": 0 },
        "storageReservationBytes": { "type": "integer", "minimum": 0 },
        "acceleratorUnits": { "type": "integer", "minimum": 0 },
        "modelSessionUnits": { "type": "integer", "minimum": 0 },
        "estimatedDurationMs": { "type": "integer", "minimum": 0 },
        "maximumParallelPerDevice": { "type": "integer", "minimum": 1 },
        "exclusiveGroup": { "type": "string", "minLength": 1 }
      }
    }
  }
}
