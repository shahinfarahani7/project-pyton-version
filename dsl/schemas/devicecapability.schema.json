{
  "$id": "https://schemas.edgemint.example/v1/devicecapability.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "EdgeMint DeviceCapability",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "DeviceCapability"
    },
    "metadata": {
      "additionalProperties": false,
      "type": "object",
      "required": ["name", "version", "status", "owners"],
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "type": "string",
          "enum": ["draft", "evaluation", "active", "deprecated", "retired", "blocked"]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "spec": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "platform",
        "deviceTier",
        "regionCode",
        "runtimeAbi",
        "resourceVector",
        "runtimeClasses",
        "storage",
        "memory"
      ],
      "properties": {
        "platform": {
          "additionalProperties": false,
          "type": "object",
          "required": ["os", "abi"],
          "properties": {
            "os": {
              "type": "string",
              "enum": ["android", "ios", "linux_edge"]
            },
            "abi": {
              "type": "string",
              "minLength": 1
            },
            "apiLevel": {
              "type": "integer",
              "minimum": 1
            },
            "pageSizeKb": {
              "type": "integer",
              "enum": [4, 16]
            }
          }
        },
        "deviceTier": {
          "type": "string",
          "pattern": "^T[1-4]$"
        },
        "regionCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16
        },
        "runtimeAbi": {
          "type": "string",
          "minLength": 1
        },
        "resourceVector": {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "cpuUnits",
            "memoryBytes",
            "storageBytes",
            "acceleratorUnits",
            "modelSessionUnits"
          ],
          "properties": {
            "cpuUnits": {
              "type": "integer",
              "minimum": 1
            },
            "memoryBytes": {
              "type": "integer",
              "minimum": 0
            },
            "storageBytes": {
              "type": "integer",
              "minimum": 0
            },
            "acceleratorUnits": {
              "type": "integer",
              "minimum": 0
            },
            "modelSessionUnits": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "runtimeClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "storage": {
          "additionalProperties": false,
          "type": "object",
          "required": ["availableBytes", "minimumFreeBytes", "maxAiStorageBytes"],
          "properties": {
            "availableBytes": {
              "type": "integer",
              "minimum": 0
            },
            "minimumFreeBytes": {
              "type": "integer",
              "minimum": 0
            },
            "maxAiStorageBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "memory": {
          "additionalProperties": false,
          "type": "object",
          "required": ["totalRamBytes", "availableBytes", "safetyReserveBytes"],
          "properties": {
            "totalRamBytes": {
              "type": "integer",
              "minimum": 0
            },
            "availableBytes": {
              "type": "integer",
              "minimum": 0
            },
            "safetyReserveBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "thermal": {
          "additionalProperties": false,
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": {
              "type": "string",
              "enum": ["nominal", "fair", "serious", "critical"]
            }
          }
        },
        "battery": {
          "additionalProperties": false,
          "type": "object",
          "required": ["levelBps", "charging"],
          "properties": {
            "levelBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "charging": {
              "type": "boolean"
            }
          }
        },
        "network": {
          "additionalProperties": false,
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["offline", "cellular", "wifi", "ethernet"]
            }
          }
        }
      }
    }
  }
}
