{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgemint.dev/schemas/policyreadinessrecord.schema.json",
  "title": "PolicyReadinessRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architectureVersion",
    "policyVersionHash",
    "runtimeProfileScope",
    "responsibleOwner",
    "values",
    "evidence",
    "compatibility",
    "featureFlags"
  ],
  "properties": {
    "architectureVersion": {
      "type": "string",
      "minLength": 1
    },
    "policyVersionHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeProfileScope": {
      "type": "string",
      "minLength": 1
    },
    "responsibleOwner": {
      "type": "string",
      "minLength": 1
    },
    "values": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerAppMinBuild", "workerAppMaxBuild"],
      "properties": {
        "workerAppMinBuild": {
          "type": "integer",
          "minimum": 1
        },
        "workerAppMaxBuild": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "featureFlags": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}
