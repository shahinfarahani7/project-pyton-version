{
  "$id": "https://schemas.edgemint.example/v1/apiproduct.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "ApiProduct"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": [
            "draft",
            "evaluation",
            "active",
            "deprecated",
            "retired",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "status",
        "owners"
      ],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "audience": {
          "type": "string"
        },
        "authentication": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "basePath": {
          "type": "string"
        },
        "idempotencyRequiredForMutations": {
          "type": "boolean"
        },
        "lifecycle": {
          "type": "string"
        },
        "openApiPath": {
          "type": "string"
        },
        "requiredHeaders": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "audience",
        "authentication",
        "basePath",
        "idempotencyRequiredForMutations",
        "lifecycle",
        "openApiPath",
        "requiredHeaders"
      ],
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "EdgeMint ApiProduct",
  "type": "object"
}
