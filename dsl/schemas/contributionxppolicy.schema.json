{
  "$id": "https://schemas.edgemint.example/v1/contributionxppolicy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "edgemint.io/v1"
    },
    "kind": {
      "const": "ContributionXpPolicy"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "type": "string"
        },
        "owners": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "status": {
          "enum": ["draft", "evaluation", "active", "deprecated", "retired", "blocked"],
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": ["name", "version", "status", "owners"],
      "type": "object"
    },
    "spec": {
      "additionalProperties": false,
      "properties": {
        "unit": {
          "const": "CENTI_XP"
        },
        "baseXp": {
          "minimum": 0,
          "type": "integer"
        },
        "xpPerAcceptedMinute": {
          "minimum": 0,
          "type": "integer"
        },
        "processingCapsMs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "taskType": {
                "minLength": 1,
                "type": "string"
              },
              "capMs": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": ["taskType", "capMs"],
            "type": "object"
          },
          "type": "array"
        },
        "levels": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": ["bronze", "silver", "gold", "platinum"]
              },
              "minXp": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": ["id", "minXp"],
            "type": "object"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        },
        "boost": {
          "additionalProperties": false,
          "properties": {
            "bonusBps": {
              "minimum": 0,
              "type": "integer"
            },
            "durationHours": {
              "minimum": 1,
              "type": "integer"
            },
            "taskQuota": {
              "minimum": 1,
              "type": "integer"
            },
            "priceTokenMinorUnits": {
              "minimum": 1,
              "type": ["integer", "null"]
            }
          },
          "required": ["bonusBps", "durationHours", "taskQuota", "priceTokenMinorUnits"],
          "type": "object"
        }
      },
      "required": ["unit", "baseXp", "xpPerAcceptedMinute", "processingCapsMs", "levels", "boost"],
      "type": "object"
    }
  },
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "title": "EdgeMint ContributionXpPolicy",
  "type": "object"
}
